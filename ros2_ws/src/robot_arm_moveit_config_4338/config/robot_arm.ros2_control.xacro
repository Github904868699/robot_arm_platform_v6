<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!--
      Fake execution path (current):
      MoveIt -> JointTrajectoryController -> ros2_control -> mock_components/GenericSystem

      Future path:
      MoveIt -> JointTrajectoryController -> ros2_control -> robot_arm_hardware_system/RobotArmHardwareSystem

      Keep upper layers protocol-agnostic. Mixed-protocol routing stays inside hardware layer.
    -->
    <xacro:macro name="robot_arm_ros2_control" params="name initial_positions_file use_fake_hardware:=true backend_mode:=fake joint_mapping_path:='' auto_enable_on_activate:=false auto_enable_delay_sec:=1.0">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
        <!--
          IMPORTANT:
          use_fake_hardware may arrive as either:
          - string: "true"/"false"
          - python bool: True/False
          Keep the check explicit to avoid accidental truthy fallback to GenericSystem.
        -->
        <xacro:property
          name="use_fake_hw_bool"
          value="${use_fake_hardware == True or str(use_fake_hardware).lower() == 'true'}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_fake_hw_bool}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_fake_hw_bool}">
                    <plugin>robot_arm_hardware_system/RobotArmHardwareSystem</plugin>
                    <param name="backend_mode">${backend_mode}</param>
                    <param name="joint_mapping_path">${joint_mapping_path}</param>
                    <param name="auto_enable_on_activate">${auto_enable_on_activate}</param>
                    <param name="auto_enable_delay_sec">${auto_enable_delay_sec}</param>
                </xacro:unless>
            </hardware>
            <joint name="joint_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint_6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
