<?xml version="1.0"?>
<package format="3">
  <name>robot_arm_core</name>
  <version>0.1.0</version>
  <description>Core ROS2 python services and mixed-protocol control skeleton.</description>
  <maintainer email="dev@example.com">robot_arm_platform</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>robot_arm_web_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
